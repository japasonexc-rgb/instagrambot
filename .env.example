# Server bootstrap configuration only.
#
# Instagram usernames, passwords and per-account IPs (proxies) are NOT
# configured here — they are entered in the web panel and stored encrypted.

# Address the HTTP server listens on (8081 so it can run next to the Telegram panel on 8080).
HTTP_ADDR=:8081

# "sqlite" or "postgres".
DB_DRIVER=sqlite

# For sqlite: a file path (directory is created automatically).
# For postgres: a standard DSN, e.g.
#   postgres://user:password@localhost:5432/instagrampanel?sslmode=disable
DB_DSN=data/instagram.db

# Secret used to sign panel JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# 32-byte (64 hex chars) key used to encrypt passwords, sessions and proxy
# URLs at rest. Generate with: openssl rand -hex 32
# Losing this key makes all stored Instagram logins unrecoverable.
ENCRYPTION_KEY=

# Allowed CORS origin for the panel frontend, or "*" for any.
CORS_ORIGIN=*

# Fetched through each account's IP/proxy by "IP'yi Test Et" to show the
# IP Instagram sees. Must return {"ip":"..."} or the bare IP.
PROXY_CHECK_URL=https://api.ipify.org?format=json

# Instagram bridge (bridge/bridge.py). By default the panel starts it itself
# with bridge/.venv/bin/python (see README). Set BRIDGE_URL + BRIDGE_TOKEN
# only if you run the bridge as a separate service.
# BRIDGE_PYTHON=bridge/.venv/bin/python
# BRIDGE_URL=http://127.0.0.1:18091
# BRIDGE_TOKEN=
